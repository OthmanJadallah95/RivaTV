<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#22F5A623" /><stroke android:width="3dp" android:color="@color/accent" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#33F5A623" /><stroke android:width="3dp" android:color="@color/accent" /><corners android:radius="8dp" /></shape>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
